#album
  - let firstAlbum = site.data.album[0]
  - let album_background = firstAlbum && firstAlbum.top_background ? firstAlbum.top_background : page.top_background
  .author-content.author-content-item.album.single(style=`${album_background ? `background: url(${album_background}) top / cover no-repeat;` : ""}`)
    .card-content
      .author-content-item-tips 相册集
      span.author-content-item-title= firstAlbum ? firstAlbum.class_name : '这里是我的相册集哦😯'
      .content-bottom
        .tips= firstAlbum ? firstAlbum.description : '每一张照片都是一次美好的记忆。'
  
  if firstAlbum && firstAlbum.album_list
    section.timeline.page-1
      .type-gallery
        - const rowHeight = firstAlbum.rowHeight != "undefined" ? firstAlbum.rowHeight : 220
        - const limit = firstAlbum.limit != "undefined" ? firstAlbum.limit : 20
        - const lazyload = firstAlbum.lazyload != "undefined" ? firstAlbum.lazyload : true
        - const lazyloadClass = lazyload == true ? "lazyload" : "";
        - const btn = firstAlbum.btnLazyload != "undefined" ? firstAlbum.btnLazyload : false
        - const btnLazyloadClass = btn == true ? " btn_album_detail_lazyload" : "";
        - const imgType = firstAlbum.url ? " url" : " data";
        - let dataStr = []
        - let durl = firstAlbum.url ?? false
        each item, index in firstAlbum.album_list
          each iten, indey in item.image
              - let obj = {}
              - obj.url = iten
              - obj.alt = item.content
              - obj.title = item.content
              - dataStr.push(obj)
        .gallery
          .fj-gallery(data-rowHeight=rowHeight data-limit=limit class=`${lazyloadClass + btnLazyloadClass + imgType}`)
            if durl 
              span.gallery-data=durl
            else 
              span.gallery-data=JSON.stringify(dataStr)
          if btn
            button.gallery-load-more
              span=_p('load_more')
              i.anzhiyufont.anzhiyu-icon-arrow-down
          else 
            #album_detail_gallery_load_more
