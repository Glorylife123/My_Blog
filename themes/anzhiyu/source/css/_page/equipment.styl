// 我的装备
.goodthings-title
  margin: 1.25rem 0 .45rem
  line-height: 1.1
  font-size: 1.8rem
  font-weight: 700

.goodthings-item
  margin-bottom: 2rem

.goodthings-item-description
  color: var(--anzhiyu-secondtext)
  margin-bottom: 1rem
  font-size: .98rem
  line-height: 1.7

.equipment-item
  .equipment-item-content
    display: grid
    grid-template-columns: repeat(3, minmax(0, 1fr))
    gap: 18px
    .equipment-item-content-item
      width: 100%
      border-radius: 26px
      border: 1px solid rgba(66, 90, 239, 0.12)
      overflow: hidden
      background: linear-gradient(180deg, rgba(255,255,255,.84), rgba(255,255,255,.98))
      box-shadow: 0 20px 45px rgba(29, 52, 102, 0.09)
      min-height: 400px
      position: relative
      transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease
      +maxWidth1200()
        width: 100%
        grid-column: span 1
      +maxWidth768()
        width: 100%
      
      .equipment-item-content-item-info
        padding: 1rem 1.15rem 1.15rem
        margin-top: 0
        display: flex
        flex-direction: column
        min-height: 210px

      .equipment-item-content-item-name
        font-size: 18px
        font-weight: bold
        line-height: 1.35
        margin-bottom: 10px
        display: inline-block
        color: var(--anzhiyu-fontcolor)
        text-decoration: none
        &:hover
          color: var(--anzhiyu-main)

      .equipment-item-content-item-specification
        font-size: 12px
        color: var(--anzhiyu-secondtext)
        line-height: 1.5
        margin-bottom: 10px
        display: inline-flex
        align-items: center
        padding: 4px 10px
        border-radius: 999px
        background: rgba(66, 90, 239, 0.08)

      .equipment-item-content-item-description
        line-height: 1.72
        color: var(--anzhiyu-secondtext)
        min-height: 96px
        display: -webkit-box
        overflow: hidden
        -webkit-line-clamp: 4
        -webkit-box-orient: vertical
        font-size: 14px

      a.equipment-item-content-item-link
        font-size: 12px
        background: rgba(66, 90, 239, 0.08)
        padding: 7px 12px
        border-radius: 999px
        cursor: pointer
        color: var(--anzhiyu-fontcolor)
        text-decoration: none

        &:hover
          background: var(--anzhiyu-main)
          color: var(--anzhiyu-white)

      .equipment-item-content-item-cover
        width: 100%
        height: 220px
        background: linear-gradient(135deg, rgba(66, 90, 239, 0.08), rgba(96, 165, 250, 0.12))
        display: flex
        justify-content: center
        align-items: center

      img.equipment-item-content-item-image
        object-fit: contain
        height: 80%
        width 260px
        transition: transform .3s ease

      .equipment-item-content-item-toolbar
        display: flex
        justify-content: space-between
        align-items: center
        margin-top: auto
        padding-top: 14px

      &:hover
        transform: translateY(-6px)
        box-shadow: 0 26px 60px rgba(29, 52, 102, 0.15)
        border-color: rgba(66, 90, 239, 0.22)

        img.equipment-item-content-item-image
          transform: scale(1.04)

body[data-type="equipment"] #web_bg
  background: var(--anzhiyu-background);
body[data-type="equipment"] #page
  border: 0;
  box-shadow: none !important;
  padding: 0 !important;
  background: 0 0 !important;
body[data-type="equipment"] #page .page-title
  display: none;

body[data-type="equipment"] #equipment
  width: calc(100% - 32px)
  max-width: 1180px
  margin: 0 auto

body[data-type="equipment"] #equipment .author-content.author-content-item.fcirclePage.single
  border-radius: 30px
  overflow: hidden
  position: relative
  box-shadow: 0 24px 60px rgba(34, 55, 110, 0.16)

body[data-type="equipment"] #equipment .author-content.author-content-item.fcirclePage.single::before
  content: ""
  position: absolute
  inset: 0
  background: linear-gradient(135deg, rgba(17, 31, 67, 0.8), rgba(45, 76, 153, 0.48))
  z-index: 0

body[data-type="equipment"] #equipment .author-content.author-content-item.fcirclePage.single .card-content
  position: relative
  z-index: 1
  padding: 2rem

[data-theme="dark"] .equipment-item .equipment-item-content .equipment-item-content-item
  background: linear-gradient(180deg, rgba(20, 25, 39, 0.94), rgba(15, 19, 31, 0.98))
  border-color: rgba(96, 165, 250, 0.14)

[data-theme="dark"] .equipment-item .equipment-item-content .equipment-item-content-item .equipment-item-content-item-specification,
[data-theme="dark"] .equipment-item .equipment-item-content .equipment-item-content-item a.equipment-item-content-item-link
  background: rgba(96, 165, 250, 0.14)

@media screen and (max-width: 1200px)
  .equipment-item
    .equipment-item-content
      grid-template-columns: repeat(2, minmax(0, 1fr))

@media screen and (max-width: 768px)
  body[data-type="equipment"] #equipment
    width: calc(100% - 20px)
    max-width: 100%
  .equipment-item
    .equipment-item-content
      grid-template-columns: 1fr


