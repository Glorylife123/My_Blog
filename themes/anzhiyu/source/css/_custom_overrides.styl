/* 浅色模式下全局导航栏及文章标题背景改为绿色 */
[data-theme='light'] .post #nav,
[data-theme='light'] .post #nav:not(.min) .menus_items,
[data-theme='light'] .post #nav .menus_items,
[data-theme='light'] .post #nav.show {
    background-color: #4CAF50 !important;
    background-image: none !important;
    backdrop-filter: none !important;
}

/* 导航栏下拉菜单背景改为绿色 */
[data-theme='light'] .post #nav .menus_item_child {
    background-color: #4CAF50 !important;
}

[data-theme='light'] .post #nav .menus_item_child:before {
    background-color: #4CAF50 !important;
}

/* 确保导航栏内部文字看得清（设为白色） */
[data-theme='light'] .post #nav a,
[data-theme='light'] .post #nav span,
[data-theme='light'] .post #nav i {
    color: #ffffff !important;
}

/* 文章标题部分背景改为绿色 */
[data-theme='light'] .post #page-header,
[data-theme='light'] .post #page-header.post-bg,
[data-theme='light'] .post #page-header.not-home-page,
[data-theme='light'] .post #page-header.not-top-img {
    background-color: #4CAF50 !important;
    background-image: none !important;
    backdrop-filter: none !important;
}

/* 强制隐藏默认的文章顶部头图，以确保绿色背景能显露出来 */
[data-theme='light'] .post #post-top-cover,
[data-theme='light'] .post #post-top-cover img {
    display: none !important;
}

/* 确保文章标题部分的文字设为白色 */
[data-theme='light'] .post #page-header * {
    color: #ffffff !important;
    text-shadow: none !important;
}

[data-theme='light'] .post #post-info .post-title,
[data-theme='light'] .post #post-info #post-meta,
[data-theme='light'] .post #post-info .meta-secondline a {
    color: #ffffff !important;
}

/* 控制台文字颜色调整，彻底解决与浅色背景融为一体的问题 */
[data-theme='light'] #console .item-headline,
[data-theme='light'] #console .console-card-title,
[data-theme='light'] #console .card-tag-cloud a,
[data-theme='light'] #console .card-archive-list-link,
[data-theme='light'] #console .console-btn-item {
    color: #000000 !important;
}
