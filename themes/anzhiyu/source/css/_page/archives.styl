$tunnel-color-1 = #e74c3c
$tunnel-color-2 = #f39c12
$tunnel-color-3 = #2ecc71
$tunnel-color-4 = #1abc9c
$tunnel-color-5 = #3498db

.article-sort
  margin: 2rem 0
  position: relative
  &::before
    content: ''
    position: absolute
    top: 2rem
    bottom: 2rem
    left: 50%
    width: 2px
    background: linear-gradient(to bottom, transparent, var(--anzhiyu-main), transparent)
    transform: translateX(-50%)
    opacity: 0.5
    z-index: 0
    +maxWidth768()
      left: 10px

  &-title
    margin: 0.25rem 0 2rem 0;
    padding: 0;
    text-align: center;
    border: none;
    font-weight: bold;
    font-size: 2.5em;
    position: relative;
    z-index: 1;

  &-item
    position: relative
    display: flex
    align-items: center
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1), box-shadow 0.3s;
    background: var(--card-bg)
    border: 1px solid var(--anzhiyu-navbg);
    margin: 1.5rem 0;
    border-radius: 12px;
    width: calc(50% - 2rem);
    z-index: 1;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);

    +maxWidth768()
      width: calc(100% - 2rem);
      margin-left: 2rem !important;

    &:nth-child(even):not(.year)
      margin-left: auto;
      flex-direction: row;
      border-left-style: solid;
      border-left-width: 6px;
      &::before
        content: ''
        position: absolute
        left: -2rem
        top: 50%
        width: 1.5rem
        height: 2px
        background: var(--anzhiyu-main)
        opacity: 0.3
        +maxWidth768()
          display: none

    &:nth-child(odd):not(.year)
      margin-right: auto;
      flex-direction: row-reverse;
      text-align: right;
      border-right-style: solid;
      border-right-width: 6px;
      &::after
        content: ''
        position: absolute
        right: -2rem
        top: 50%
        width: 1.5rem
        height: 2px
        background: var(--anzhiyu-main)
        opacity: 0.3
        +maxWidth768()
          display: none
      +maxWidth768()
        flex-direction: row;
        border-right-width: 1px;
        border-left-width: 6px;
        border-left-style: solid;
        text-align: left;

    &:nth-child(5n+1):not(.year)
      border-color: $tunnel-color-1
      &:hover
        box-shadow: 0 8px 16px rgba(231, 76, 60, 0.2);
    &:nth-child(5n+2):not(.year)
      border-color: $tunnel-color-2
      &:hover
        box-shadow: 0 8px 16px rgba(243, 156, 18, 0.2);
    &:nth-child(5n+3):not(.year)
      border-color: $tunnel-color-3
      &:hover
        box-shadow: 0 8px 16px rgba(46, 204, 113, 0.2);
    &:nth-child(5n+4):not(.year)
      border-color: $tunnel-color-4
      &:hover
        box-shadow: 0 8px 16px rgba(26, 188, 156, 0.2);
    &:nth-child(5n+5):not(.year)
      border-color: $tunnel-color-5
      &:hover
        box-shadow: 0 8px 16px rgba(52, 152, 219, 0.2);

    &:hover
      transform: translateY(-4px)
      .article-sort-item-img img
        transform: scale(1.05)

    &.no-article-cover
      height: 100px
      background: var(--card-bg)

    &.year
      font-size: 1.5rem;
      font-weight: bold;
      color: var(--anzhiyu-secondtext);
      margin: 2rem auto;
      width: max-content;
      text-align: center;
      background: var(--anzhiyu-background);
      padding: 0.5rem 1.5rem;
      border-radius: 20px;
      border: 2px dashed var(--anzhiyu-main);
      box-shadow: none;
      &::before
      &::after
        display: none

      +maxWidth768()
        margin-left: 1.5rem !important;

    &-time
      color: $theme-meta-color
      font-size: 95%
      margin-top: 5px;
      time
        padding-left: 6px
        cursor: default

    &-title
      @extend .limit-more-line
      color: var(--font-color)
      font-size: 1.1em
      transition: all .3s
      -webkit-line-clamp: 2
      overflow: hidden;
      text-overflow: ellipsis;
      order: 0;
      font-weight: bold;
      line-height: 1.4;
      margin-bottom: 5px;

      &:hover
        color: var(--anzhiyu-lighttext)

    &-index
      opacity: .1
      position: absolute
      top: -0.5rem
      left: 1rem
      font-style: italic
      font-size: 4rem
      line-height: 4rem
      font-weight: 900;
      pointer-events: none;
      z-index: 0;

    &-img
      overflow: hidden
      width: 151px
      height: 110px
      border-radius: 12px;
      min-width: 151px;
      min-height: 110px;
      background: var(--anzhiyu-secondbg);
      z-index: 1;

      img
        @extend .imgHover
        width: 100%;
        height: 100%;
        object-fit: cover;

    &-info
      padding: 1rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      justify-content: center;
      z-index: 1;

      .article-meta-wrap
        display: flex;
        flex-direction: column;
        .article-sort-item-tags a
          color: var(--anzhiyu-fontcolor);
          transition: 0.3s;
          margin: 5px 5px 0 0;
          padding: 2px 6px;
          border-radius: 4px;
          background: rgba(0,0,0,0.05);
          display: inline-block;
          font-size: 12px;
          &:hover
            background: var(--anzhiyu-main);
            color: #fff;
          span
            pointer-events: none
