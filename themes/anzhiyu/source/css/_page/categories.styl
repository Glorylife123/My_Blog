.category-lists
  display: grid
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr))
  gap: 16px
  padding: 6px 0 0

  a
    display: flex
    align-items: center
    justify-content: space-between
    gap: 10px
    padding: 14px 16px
    border-radius: 20px
    text-decoration: none
    color: var(--font-color)
    border: 1px solid rgba(66, 90, 239, 0.12)
    background: linear-gradient(180deg, rgba(255,255,255,.82), rgba(255,255,255,.98))
    box-shadow: 0 14px 36px rgba(29, 52, 102, 0.08)
    transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease

    &:hover
      color: var(--anzhiyu-main)
      transform: translateY(-4px)
      box-shadow: 0 22px 46px rgba(29, 52, 102, 0.14)
      border-color: rgba(66, 90, 239, 0.24)

  .tags-punctuation
    display: inline-flex
    align-items: center
    justify-content: center
    width: 28px
    height: 28px
    border-radius: 50%
    background: rgba(66, 90, 239, 0.1)
    color: var(--anzhiyu-main)
    font-weight: 700
    flex-shrink: 0
    margin-right: 8px

  .tagsPageCount
    margin-left: auto
    min-width: 28px
    height: 28px
    padding: 0 8px
    border-radius: 999px
    display: inline-flex
    align-items: center
    justify-content: center
    background: rgba(66, 90, 239, 0.1)
    color: var(--anzhiyu-main)
    font-size: .82rem
    font-weight: 700

body[data-type="categories"] #page
  border: 0
  box-shadow: none !important
  padding: 0 !important
  background: transparent !important

body[data-type="categories"] #tag
  width: calc(100% - 32px)
  max-width: 1180px
  margin: 0 auto
  padding: 0

[data-theme="dark"] .category-lists a
  background: linear-gradient(180deg, rgba(20, 25, 39, 0.94), rgba(15, 19, 31, 0.98))
  border-color: rgba(96, 165, 250, 0.14)

[data-theme="dark"] .category-lists .tags-punctuation,
[data-theme="dark"] .category-lists .tagsPageCount
  background: rgba(96, 165, 250, 0.14)

@media screen and (max-width: 768px)
  body[data-type="categories"] #tag
    width: calc(100% - 20px)
    max-width: 100%
  .category-lists
    grid-template-columns: 1fr
